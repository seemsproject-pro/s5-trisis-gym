# Front-end environment variables (example, no secrets)
VITE_APP_NAME="Trisis Gym Member App"
VITE_APP_ENV="demo"
VITE_API_BASE_URL="http://localhost:5000/api"
VITE_ENABLE_MOCK_DATA="true"
VITE_GEMINI_API_KEY="" # Opsional: Google Gemini API Key dari Google AI Studio (aistudio.google.com)

# Server environment variables (Phase 6B, no secrets)
PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trisis_gym_db
SESSION_SECRET=example_session_secret_change_in_production
